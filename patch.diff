+            .setAudioSource(MediaRecorder.AudioSource.VOICE_RECOGNITION)
+            .setAudioFormat(fmt)
+            .setBufferSizeInBytes(maxOf(minBuf, 16_000 * 4 * 2)) // 2 s of slack
+            .build()
+        try {
+            check(rec.state == AudioRecord.STATE_INITIALIZED) { "AudioRecord 初始化失败" }
